{
  "name": "mypuzzle-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "migrate": "node --env-file=.env --experimental-strip-types src/scripts/migrate.ts",
    "seed": "node --env-file=.env --experimental-strip-types src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@neondatabase/serverless": "^0.10.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.0",
    "@vercel/config": "^0.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  }
}
